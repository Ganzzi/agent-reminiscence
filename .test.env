# Agent Memory Test Environment Configuration
# These are the QA service addresses for host-local test execution

# PostgreSQL - port 5433 for host-local tests
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=backend
POSTGRES_PASSWORD=backend
POSTGRES_DB=agent_mem_test
POSTGRES_SSL=disable

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=neo4jpassword

# Ollama (optional - for embedding tests)
OLLAMA_BASE_URL=http://localhost:11434

# Logging
LOG_LEVEL=INFO
